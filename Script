-- TABLE CREATION
-- INSTRUCTOR (InstructorID PK, FirstName, LastName, Phone, Email, Rating) <- Relational Schema

CREATE TABLE Instructor (
  InstructorID NUMBER (6) PRIMARY KEY NOT NULL,
  FirstName VARCHAR2 (20) NOT NULL,  
  LastName VARCHAR2 (25),
  Phone VARCHAR2 (20),
  Email VARCHAR2 (25) NOT NULL,
  Rating NUMBER (1)
  );

-- MEMBER (MemberID PK, FirstName, LastName, Phone, Email, MembershipStatus, JoinDate) <- Relational Schema

CREATE TABLE Member (
  MemberID   INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY ,
  FirstName   VARCHAR2 (20) ,
  LastName   NUMBER ,
  Phone   VARCHAR2 (20) ,
  Email   VARCHAR2 (25) NOT NULL ,
  MembershipStatus VARCHAR2 (10) ,
  JoinDate DATE,
  );

-- EQUIPMENT (EquipmentID PK, EquipmentName, EquipmentType, StockQuantity, PurchaseDate, Condition) <- Relational Schema

CREATE TABLE Equipment (
  EquipmentId     NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY ,
  EquipmentName  VARCHAR2 (30) ,
  EquipmentType  VARCHAR2 (30) ,
  StockQuantity NUMBER (5) ,
  PurchaseDate DATE ,
  Condition VARCHAR2 (20) ,
  CONSTRAINT check_equipment_condition
  CHECK (condition IN ('New', 'Good', 'Fair', 'Poor', 'Retired'))
  );

-- CLASSROOM (ClassroomID PK, ClassroomType, ClassroomName, Location, Capacity) <- Relational Schema

CREATE TABLE Classroom (
  ClassroomID     NUMBER (6) PRIMARY KEY ,
  ClassroomType   VARCHAR2 (30) ,
  ClassroomName  VARCHAR2 (30) ,
  Location VARCHAR2 (50) ,
  Capacity NUMBER (2) ,
  CONSTRAINT check_classroom_capacity CHECK (capacity BETWEEN 1 AND 30)
  );

-- CLASS (ClassID PK, ClassName, Description, Duration, DifficultyLevel, InstructorID -> INSTRUCTOR) <- Relational Schema

CREATE TABLE Class (
  ClassID   NUMBER (10) PRIMARY KEY,
  InstructorID NUMBER (6) ,
  ClassName   DATE,
  Description  VARCHAR2 (50) ,
  CONSTRAINT fk_id_instructor FOREIGN KEY (InstructorID)
  REFERENCES INSTRUCTOR(InstructorId)
  );

-- CLASSSESSION (SessionID PK, SessionDate, StartTime, EndTime, Capacity, ClassID FK -> CLASS, ClassroomID -> CLASSROOM) <- ReOlational Schema

CREATE TABLE ClassSession (
  SessionID   NUMBER (12) PRIMARY KEY ,
  SessionDate   DATE ,
  StartTime  TIMESTAMP (6) ,
  EndTime TIMESTAMP (6) ,
  Capacity NUMBER (2 , 0) , 
  ClassID NUMBER (10) ,
  ClassroomID NUMBER (10 , 0) ,
  );

  ALTER TABLE ClassSession ADD CONSTRAINT fk_id_class FOREIGN KEY (ClassID)
	  REFERENCES Class (ClassID) ENABLE;
  ALTER TABLE ClassSession ADD CONSTRAINT fk_id_classroom FOREIGN KEY (ClassroomID)
	  REFERENCES Classroom (ClassroomID) ENABLE;

