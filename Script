-- QUERIES
-- 1. SELECT Statement: Top-rated instructors (rating of 4.7 or higher)
SELECT InstructorID, FirstName, LastName, Email, Rating
FROM Instructor
WHERE Rating >= 4.7
ORDER BY Rating DESC
;

-- 2. SELECT STATEMENT: All active members, newest members first
SELECT MemberID, FirstName, LastName, Email, MembershipStatus, JoinDate
FROM Member
WHERE MembershipStatus = ‘Active’
ORDER BY JoinDate DESC
;

-- 3. SELECT: Number of 5 star rated instructors who are employed at the gym
SELECT InstructorID, FirstName, LastName
FROM Instructor
WHERE Rating = 5
;

-- 4. SELECT:
SELECT Condition, COUNT(*) AS equipment_types, SUM(StockQuantity) AS total_units
FROM Equipment
GROUP BY Condition
ORDER BY total_units DESC
;

-- 5. SELECT STATEMENT: Membership status
SELECT
MemberID,
FirstName,
LastName,
MembershipStatus
FROM Member
WHERE MembershipStatus = ‘Active’
;

-- 6. JOIN: Sessions and registrations
SELECT
    CS.SessionID,
    CS.SessionDate,
    COUNT(CR.RegistrationID) AS TotalRegistrations
FROM ClassSession CS
LEFT JOIN ClassRegistration CR
    ON CS.SessionID = CR.SessionID
GROUP BY
    CS.SessionID,
    CS.SessionDate
ORDER BY
    CS.SessionDate
;

-- 7. JOIN: Full class schedule with instructor and room
SELECT cs.SessionDate,
       TO_CHAR(cs.StartTime, ‘HH24:MI’) AS start_time,
       TO_CHAR(cs.EndTime, ‘HH24:MI’) AS end_time,
       c.ClassName,
       i.FirstName || ' ' || i.LastName AS instructor,
       cl.ClassroomName, cl.Location
FROM ClassSession cs
JOIN Class c      ON c.ClassID      = cs.ClassID
JOIN Instructor i ON i.InstructorID = c.InstructorID
JOIN Classroom cl ON cl.ClassroomID = cs.ClassroomID
ORDER BY cs.SessionDate, cs.StartTime
;

-- JOIN: 8. Class session capacity
SELECT
    C.CONSTRAINT_NAME,
    C.STATUS
FROM USER_CONSTRAINTS C
JOIN USER_CONS_COLUMNS CC
    ON C.CONSTRAINT_NAME = CC.CONSTRAINT_NAME
WHERE C.TABLE_NAME = ‘CLASSREGISTRATION’
AND C.CONSTRAINT_TYPE = ‘R’
AND CC.COLUMN_NAME = ‘SESSIONID’
;

-- JOIN: 9. Room usage: sessions held in each classroom
SELECT cl.ClassroomName, cl.Location, cl.Capacity AS room_capacity,
       COUNT(cs.SessionID) AS sessions_scheduled
FROM Classroom cl
LEFT JOIN ClassSession cs ON cs.ClassroomID = cl.ClassroomID
LEFT JOIN Class c         ON c.ClassID      = cs.ClassID
GROUP BY cl.ClassroomID, cl.ClassroomName, cl.Location, cl.Capacity
ORDER BY sessions_scheduled DESC
;

-- JOIN: 10. Class and discipline
SELECT
    c.ClassID,
    d.DisciplineName
FROM Class c
INNER JOIN InstructorAbility id
    ON c.InstructorID = id.InstructorID
INNER JOIN Discipline d
    ON id.DisciplineID = d.DisciplineID
;

--JOIN: 11. Classes at max capacity
SELECT
    C.CLASSNAME,
    CS.SESSIONDATE,
    CS.CAPACITY,
    COUNT(CR.REGISTRATIONID) AS TOTAL_REGISTERED
FROM CLASSSESSION CS
JOIN CLASS C
    ON CS.CLASSID = C.CLASSID
LEFT JOIN CLASSREGISTRATION CR
    ON CS.SESSIONID = CR.SESSIONID
    AND CR.REGISTRATIONSTATUS = ‘Registered’
GROUP BY
    C.CLASSNAME,
    CS.SESSIONID,
    CS.SESSIONDATE,
    CS.CAPACITY
HAVING COUNT(CR.REGISTRATIONID) >= CS.CAPACITY
ORDER BY C.CLASSNAME
;

-- JOIN: 12. Available class openings
SELECT
    C.CLASSNAME,
    CS.SESSIONDATE,
    CS.CAPACITY,
    COUNT(CR.REGISTRATIONID) AS TOTAL_REGISTERED,
    CS.CAPACITY - COUNT(CR.REGISTRATIONID) AS SEATS_AVAILABLE
FROM CLASSSESSION CS
JOIN CLASS C
    ON CS.CLASSID = C.CLASSID
LEFT JOIN CLASSREGISTRATION CR
    ON CS.SESSIONID = CR.SESSIONID
    AND CR.REGISTRATIONSTATUS = ‘Registered’
GROUP BY
    C.CLASSNAME,
    CS.SESSIONID,
    CS.SESSIONDATE,
    CS.CAPACITY
HAVING CS.CAPACITY - COUNT(CR.REGISTRATIONID) > 0
ORDER BY C.CLASSNAME
;

-- 13. JOIN: How many classes and scheduled sessions each instructor has
SELECT i.FirstName || ' ' || i.LastName AS instructor,
       COUNT(DISTINCT c.ClassID)   AS classes_taught,
       COUNT(cs.SessionID)         AS sessions_scheduled
FROM Instructor i
LEFT JOIN Class c         ON c.InstructorID = i.InstructorID
LEFT JOIN ClassSession cs ON cs.ClassID     = c.ClassID
GROUP BY i.InstructorID, i.FirstName, i.LastName
ORDER BY sessions_scheduled DESC
;

-- 14. JOIN: Classes with the longest waitlist
SELECT c.ClassName,
       COUNT(w.WaitlistRegistrationID) AS people_waiting
FROM WaitlistRegistration w
JOIN ClassRegistration cr ON cr.RegistrationID = w.RegistrationID
JOIN ClassSession cs      ON cs.SessionID      = cr.SessionID
JOIN Class c              ON c.ClassID         = cs.ClassID
WHERE w.WaitlistRegistrationStatus = ‘Active’
GROUP BY c.ClassName
ORDER BY people_waiting DESC, c.ClassName
;


-- 15. JOIN: Number of class sessions scheduled for the same classroom on the same day
SELECT
    cs.ClassroomID,
    c.ClassroomName,
    COUNT(cs.SessionID) AS NumberOfSessions
FROM ClassSession cs
LEFT JOIN Classroom c
    ON cs.ClassroomID = c.ClassroomID
WHERE cs.SessionDate = DATE ‘2026-11-10’
GROUP BY
    cs.ClassroomID,
    c.ClassroomName
ORDER BY NumberOfSessions DESC
;
